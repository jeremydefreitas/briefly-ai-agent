# Paste your NVIDIA NIM API key here (local .env only).
# OPENAI_* names configure the OpenAI-compatible NVIDIA endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# One of the assignment-listed NVIDIA models.
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Tavily search/extract support limited keyless access; add a key for account limits.
TAVILY_API_KEY=
# Optional manifest override; relative paths are resolved from the project.
MCP_SERVERS_CONFIG=mcp_servers.json
# Project ID used for Cloud Run deployment.
GCP_PROJECT_ID=

# Cloud Run injects PORT; this is the local default.
PORT=8080
